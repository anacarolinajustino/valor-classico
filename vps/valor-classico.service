[Unit]
Description=Valor Classico — Flask via Gunicorn
After=network.target postgresql.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/var/www/valor-classico
EnvironmentFile=/var/www/valor-classico/.env.production
ExecStart=/var/www/valor-classico/venv/bin/gunicorn app:app \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --timeout 300 \
    --access-logfile /var/log/valor-classico/access.log \
    --error-logfile /var/log/valor-classico/error.log
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
